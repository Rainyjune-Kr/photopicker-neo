{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photo Picker neo",
  "version": "0.1.0",
  "identifier": "kr.rainyjune.photopickerneo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Photo Picker neo",
        "width": 1000,
        "height": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "third-party/"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFOEUyRjI5NEEwNzdFMDcKUldRSGZnZEtLUytPampZS29vK014RXpEZEU1eGV4VDJRbE9NOUI0ZHRTZjI0MjF4dlpvYjRrMWUK",
      "endpoints": [
        "https://github.com/Rainyjune-Kr/photopicker-neo/releases/latest/download/latest.json"
      ]
    }
  }
}
